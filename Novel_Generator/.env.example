# Backend
APP_ENV=local
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://novel:novel_password@localhost:5432/novel_generator
CORS_ORIGINS=http://localhost:3000

# AI (Phase 4/5: mock | openai)
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
# AI_MODEL_OUTLINE=gpt-4o
# AI_MODEL_VOLUME=gpt-4o-mini
# AI_MODEL_CHAPTER=gpt-4o-mini
# AI_MODEL_PROFILE_FAST=gpt-4o-mini
# AI_MODEL_PROFILE_QUALITY=gpt-4o
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_BATCH_MAX_CHAPTERS=5
# GENERATION_FORCE_SYNC=0

# Storage
LOCAL_STORAGE_DIR=./storage

# Queue (Phase 6–8)
# REDIS_URL=redis://127.0.0.1:6379/0
# GENERATION_QUEUE_BACKEND=auto
# REDIS_QUEUE_NAME=novel:generation
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# CELERY_QUEUE_NAME=novel:generation

# External publish (Phase 6)
# PUBLISH_WEBHOOK_URL=https://example.com/novel/publish
# PUBLISH_WEBHOOK_SECRET=change-me
# PUBLISH_PLATFORM_API_URL=https://platform.example/api/publications
# PUBLISH_PLATFORM_API_TOKEN=change-me
# PUBLISH_PLATFORM_PRESET=default

# Style analysis (Phase 9)
# STYLE_SAMPLE_MAX_CHARS=12000
# STYLE_UPLOAD_MAX_MB=10
# STYLE_ANALYSIS_FORCE_SYNC=0

# Frontend (copy to apps/web/.env.local)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
